+// Fallback-hooked instructions run through the host's interpreter hook,
+// which leaves ctx->pc at the resume address. When the instruction simply
+// advanced (no exception, no control transfer), control continues natively
+// at the next label — a block leader that applies its own cycle charge —
+// instead of bouncing through the dispatcher. Cache maintenance and
+// unmodeled SPR moves are issued in tight loops, thousands per frame.
+static void emit_fallback_with_fallthrough(FILE* out, const PPCInst* inst) {
+    fprintf(out, "    ppc_fallback_instruction(ctx, 0x%08Xu, 0x%08Xu);\n",
+            inst->raw, inst->address);
+    fprintf(out, "    if (ctx->pc != 0x%08Xu) return;\n", inst->address + 4);
+}
+

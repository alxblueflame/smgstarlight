+bool IsCompatiblePipelineUidCache(const fs::path& path)
+{
+  constexpr std::array<std::uint8_t, 8> header{0x50, 0x55, 0x49, 0x44, 0x08, 0, 0, 0};
+  constexpr std::uintmax_t record_size = 173;
+  std::error_code ec;
+  const std::uintmax_t size = fs::file_size(path, ec);
+  if (ec || size < header.size() || (size - header.size()) % record_size != 0)
+    return false;
+
+  std::array<std::uint8_t, 8> actual{};
+  std::ifstream stream(path, std::ios::binary);
+  return stream.read(reinterpret_cast<char*>(actual.data()), actual.size()) && actual == header;
+}

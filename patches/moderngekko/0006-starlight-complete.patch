+#if defined(_WIN32)
+// The MSVC runtime joins the _wspawnv argument vector into a single command line
+// without quoting, so any argument containing a space (including argv[0] when the
+// release lives in a path like "Nueva carpeta (4)") is re-split by the child's
+// parser. Apply the standard Windows command-line quoting rules ourselves.
+std::wstring QuoteWindowsArgument(const std::wstring& argument)
+{
+  if (!argument.empty() && argument.find_first_of(L" \t\n\v\"") == std::wstring::npos)
+    return argument;
+
+  std::wstring result = L"\"";
+  for (auto it = argument.begin();; ++it)
+  {
+    std::size_t backslashes = 0;
+    while (it != argument.end() && *it == L'\\')
+    {
+      ++it;
+      ++backslashes;
+    }
+
+    if (it == argument.end())
+    {
+      // Escape the backslashes that would otherwise escape the closing quote.
+      result.append(backslashes * 2, L'\\');
+      break;
+    }
+
+    if (*it == L'"')
+      result.append(backslashes * 2 + 1, L'\\');
+    else
+      result.append(backslashes, L'\\');
+    result.push_back(*it);
+  }
+  result.push_back(L'"');
+  return result;
+}
+#endif

+
+bool ValidateExtractedTree(const DiscIO::FileInfo& directory, const fs::path& export_root,
+                           const fs::path& relative, ExtractedTreeStats* stats,
+                           std::string* error)
+{
+  std::error_code ec;
+  for (const DiscIO::FileInfo& entry : directory)
+  {
+    const fs::path entry_relative = relative / entry.GetName();
+    const fs::path extracted = export_root / entry_relative;
+    if (entry.IsDirectory())
+    {
+      if (!fs::is_directory(extracted, ec) || ec)
+      {
+        *error = "missing extracted directory: " + entry_relative.string();
+        return false;
+      }
+      if (!ValidateExtractedTree(entry, export_root, entry_relative, stats, error))
+        return false;
+      continue;
+    }
+
+    const std::uintmax_t actual_size = fs::file_size(extracted, ec);
+    if (ec)
+    {
+      *error = "missing extracted file: " + entry_relative.string();
+      return false;
+    }
+    if (actual_size != entry.GetSize())
+    {
+      *error = "incomplete extracted file: " + entry_relative.string() + " (expected " +
+               std::to_string(entry.GetSize()) + ", got " + std::to_string(actual_size) + ")";
+      return false;
+    }
+    ++stats->files;
+    stats->bytes += actual_size;
+  }
+  return true;
+}
+
+bool ValidateExtractedGame(const fs::path& root, const DiscIO::FileSystem& filesystem,
+                           ExtractedTreeStats* stats, std::string* error)
+{
+  const auto inspected = moderngekko::InspectGame(root);
+  if (!inspected)
+  {
+    *error = inspected.error;
+    return false;
+  }
+  return ValidateExtractedTree(filesystem.GetRoot(), root / "files", {}, stats, error);
+}

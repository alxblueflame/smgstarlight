+int RunGame(const fs::path& runner, const fs::path& game, const fs::path& user_directory,
+            const std::optional<fs::path>& module, const std::string& graphics,
+            bool use_wayland)
+{
+#if defined(_WIN32)
+  const fs::path log_directory = user_directory / L"Logs";
+  std::error_code log_error;
+  fs::create_directories(log_directory, log_error);
+  std::vector<std::wstring> arguments = {
+      runner.native(), L"--game", game.native(), L"--user-dir", user_directory.native(),
+      L"--stdout-log", (log_directory / L"starlight-last-run.stdout.log").native(),
+      L"--stderr-log", (log_directory / L"starlight-last-run.stderr.log").native()};
+  if (module)
+  {
+    arguments.emplace_back(L"--module");
+    arguments.emplace_back(module->native());
+  }
+  if (!graphics.empty())
+  {
+    arguments.emplace_back(L"--graphics");
+    arguments.emplace_back(fs::path(graphics).native());
+  }
+
+  std::vector<std::wstring> quoted_arguments;
+  quoted_arguments.reserve(arguments.size());
+  for (const std::wstring& argument : arguments)
+    quoted_arguments.emplace_back(QuoteWindowsArgument(argument));
+
+  std::vector<const wchar_t*> argument_pointers;
+  argument_pointers.reserve(quoted_arguments.size() + 1);
+  for (const std::wstring& argument : quoted_arguments)
+    argument_pointers.emplace_back(argument.c_str());
+  argument_pointers.emplace_back(nullptr);
+
+  const intptr_t result =
+      _wspawnv(_P_WAIT, runner.c_str(), argument_pointers.data());
+  if (result == -1)
+  {
+    std::cerr << "Failed to start " << runner << '\n';
+    return 1;
+  }
+  return static_cast<int>(result);
+#else
+  std::string command = Quote(runner) + " --game " + Quote(game) +
+                        " --user-dir " + Quote(user_directory);
+  if (module)
+    command += " --module " + Quote(*module);
+  if (!graphics.empty())
+    command += " --graphics " + Quote(graphics);
+  if (use_wayland)
+    command += " --wayland";
+  return std::system(command.c_str()) == 0 ? 0 : 1;
+#endif
+}

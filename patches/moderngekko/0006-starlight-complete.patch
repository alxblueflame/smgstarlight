+std::optional<RuntimeError> Runtime::SaveState(const std::filesystem::path& path)
+{
+  if (!m_impl->running || !m_impl->booted)
+    return RuntimeError{RuntimeErrorCode::InvalidState, "runtime is not running"};
+
+  std::error_code ec;
+  if (!path.parent_path().empty())
+    std::filesystem::create_directories(path.parent_path(), ec);
+  if (ec)
+    return RuntimeError{RuntimeErrorCode::InitializationFailed,
+                        "could not create savestate directory: " + ec.message()};
+
+  State::SaveAs(Core::System::GetInstance(), path.string());
+  return std::nullopt;
+}
+
+std::optional<RuntimeError> Runtime::LoadState(const std::filesystem::path& path)
+{
+  if (!m_impl->running || !m_impl->booted)
+    return RuntimeError{RuntimeErrorCode::InvalidState, "runtime is not running"};
+  if (!std::filesystem::is_regular_file(path))
+    return RuntimeError{RuntimeErrorCode::InvalidState, "savestate does not exist"};
+
+  State::LoadAs(Core::System::GetInstance(), path.string());
+  if (m_impl->config.graphics.prioritize_stable_60fps)
+    FrontendInput::ReleaseFileSelect();
+  return std::nullopt;
+}
+
+std::optional<RuntimeError> Runtime::ImportWiiSave(const std::filesystem::path& path)
+{
+  if (m_impl->running)
+    return RuntimeError{RuntimeErrorCode::InvalidState, "cannot import a Wii save while the game is running"};
+  if (!std::filesystem::is_regular_file(path))
+    return RuntimeError{RuntimeErrorCode::InvalidState, "Wii save file does not exist"};
+
+  const WiiSave::CopyResult result = WiiSave::Import(path.string(), [] { return true; });
+  if (result != WiiSave::CopyResult::Success)
+  {
+    return RuntimeError{RuntimeErrorCode::InitializationFailed,
+                        "could not import Wii data.bin (result " +
+                            std::to_string(static_cast<int>(result)) + ")"};
+  }
+  return std::nullopt;
 }
 
 std::optional<RuntimeError> Runtime::Pause()

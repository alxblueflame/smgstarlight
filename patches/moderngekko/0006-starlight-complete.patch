+
+void InstallShaderCacheSeed(const std::filesystem::path& application_directory,
+                            const std::filesystem::path& user_directory)
+{
+  const std::filesystem::path source = application_directory / "ShaderCache";
+  if (!std::filesystem::is_directory(source))
+    return;
+
+  const std::filesystem::path destination = user_directory / "Cache";
+  std::error_code ec;
+  for (std::filesystem::recursive_directory_iterator it(source, ec), end; !ec && it != end;
+       it.increment(ec))
+  {
+    if (!it->is_regular_file(ec) || ec || it->path().extension() != ".uidcache")
+      continue;
+
+    const std::filesystem::path relative = std::filesystem::relative(it->path(), source, ec);
+    if (ec)
+      break;
+    const std::filesystem::path target = destination / relative;
+    const std::uintmax_t source_size = it->file_size(ec);
+    if (ec || !IsCompatiblePipelineUidCache(it->path()))
+      break;
+
+    std::filesystem::create_directories(target.parent_path(), ec);
+    if (ec)
+      break;
+    std::error_code target_error;
+    const bool target_exists = std::filesystem::is_regular_file(target, target_error);
+    const std::uintmax_t target_size =
+        target_exists ? std::filesystem::file_size(target, target_error) : 0;
+    if (target_exists && !target_error && IsCompatiblePipelineUidCache(target) &&
+        target_size >= source_size)
+      continue;
+
+    std::filesystem::copy_file(it->path(), target,
+                               std::filesystem::copy_options::overwrite_existing, ec);
+    if (ec)
+      break;
+  }
+  if (ec)
+    std::cerr << "Could not install the shader cache seed: " << ec.message() << '\n';
+}

+bool ApplyGeneratedSourcePatch(const fs::path& chunk, std::string_view label,
+                               std::string_view original, std::string_view patched,
+                               std::string_view description)
+{
+  std::ifstream input(chunk, std::ios::binary);
+  if (!input)
+  {
+    std::cerr << "game patch source is missing: " << chunk << '\n';
+    return false;
+  }
+
+  std::string source((std::istreambuf_iterator<char>(input)), std::istreambuf_iterator<char>());
+  const std::size_t label_position = source.find(label);
+  if (label_position == std::string::npos)
+  {
+    std::cerr << description << " label does not match the pinned USA revision\n";
+    return false;
+  }
+
+  const std::size_t next_label = source.find("\nlabel_", label_position + label.size());
+  const std::size_t original_position = source.find(original, label_position);
+  const std::size_t patched_position = source.find(patched, label_position);
+  if (patched_position != std::string::npos &&
+      (next_label == std::string::npos || patched_position < next_label))
+  {
+    return true;
+  }
+  if (original_position == std::string::npos ||
+      (next_label != std::string::npos && original_position >= next_label))
+  {
+    std::cerr << description << " instruction does not match the pinned USA revision\n";
+    return false;
+  }
+
+  source.replace(original_position, original.size(), patched);
+  std::ofstream output(chunk, std::ios::binary | std::ios::trunc);
+  output.write(source.data(), static_cast<std::streamsize>(source.size()));
+  return static_cast<bool>(output);
+}
+
+std::optional<fs::path> FindGeneratedChunk(const fs::path& generated, std::string_view label)
+{
+  const fs::path chunks = generated / "chunks";
+  std::error_code ec;
+  for (fs::directory_iterator it(chunks, ec), end; !ec && it != end; it.increment(ec))
+  {
+    if (!it->is_regular_file(ec) || it->path().extension() != ".c")
+      continue;
+
+    std::ifstream input(it->path(), std::ios::binary);
+    std::string line;
+    while (std::getline(input, line))
+    {
+      if (line.find(label) != std::string::npos)
+        return it->path();
+    }
+  }
+  std::cerr << "generated source label was not found: " << label << '\n';
+  return std::nullopt;
+}
+
+bool DisableAutomaticHostDispatch(const fs::path& header)
+{
+  std::ifstream input(header, std::ios::binary);
+  if (!input)
+  {
+    std::cerr << "generated header is missing: " << header << '\n';
+    return false;
+  }
+
+  std::string source((std::istreambuf_iterator<char>(input)), std::istreambuf_iterator<char>());
+  constexpr std::string_view address_probe =
+      "if (ctx->host_call && ppc_host_call(ctx, address)) return 1;";
+  constexpr std::string_view alias_probe =
+      "if (ctx->host_call && ppc_host_call(ctx, alias)) return 1;";
+  constexpr std::string_view address_marker =
+      "/* RMGE01 invokes host callbacks only at explicit generated gates. */";
+  constexpr std::string_view alias_marker =
+      "/* RMGE01 automatic alias host callback disabled. */";
+
+  if (source.find(address_marker) != std::string::npos &&
+      source.find(alias_marker) != std::string::npos)
+  {
+    return true;
+  }
+
+  const std::size_t address_position = source.find(address_probe);
+  const std::size_t alias_position = source.find(alias_probe);
+  if (address_position == std::string::npos || alias_position == std::string::npos)
+  {
+    std::cerr << "RMGE01 dolrecomp_call host probes do not match the pinned generator\n";
+    return false;
+  }
+
+  source.replace(alias_position, alias_probe.size(), alias_marker);
+  source.replace(address_position, address_probe.size(), address_marker);
+  std::ofstream output(header, std::ios::binary | std::ios::trunc);
+  output.write(source.data(), static_cast<std::streamsize>(source.size()));
+  return static_cast<bool>(output);
+}
+
+bool ApplyGameSourcePatches(const moderngekko::GameMetadata& game, const fs::path& generated,
+                            const fs::path& emitted_header)
+{
+  if (game.disc_id != "RMGE01")
+    return true;
+
+  const auto warning_chunk = FindGeneratedChunk(generated, "label_80340408:");
+  const auto title_chunk = FindGeneratedChunk(generated, "label_8038F268:");
+  const auto file_select_chunk = FindGeneratedChunk(generated, "label_8017C8D0:");
+  if (!warning_chunk || !title_chunk || !file_select_chunk)
+    return false;
+
+  const bool warning_patch = ApplyGeneratedSourcePatch(
+      *warning_chunk, "label_80340408:",
+      "ctx->gpr[4] = ctx->gpr[13] + (u32)(s32)(-12432);",
+      "ctx->gpr[4] = ctx->gpr[13] + (u32)(s32)(-12416);", "RMGE01 LogoScene::init");
+  if (!warning_patch)
+    return false;
+
+  const bool title_confirm_gate_patch = ApplyGeneratedSourcePatch(
+      *title_chunk, "label_8038F268:",
+      "ctx->downcount -= 2;",
+      "if (ppc_host_call(ctx, 0x4D474B02u))\n"
+      "        goto label_8038F288;\n"
+      "    ctx->downcount -= 2;",
+      "RMGE01 TitleSequenceProduct::exeLogoDisplay confirm gate");
+  if (!title_confirm_gate_patch)
+    return false;
+
+  const bool file_select_prepare_patch = ApplyGeneratedSourcePatch(
+      *file_select_chunk, "label_8017C8D0:",
+      "ctx->downcount -= 4;",
+      "ctx->downcount -= 4;\n"
+      "    ppc_host_call(ctx, 0x4D474B00u);",
+      "RMGE01 FileSelector::exeTitleEnd prepare");
+  if (!file_select_prepare_patch)
+    return false;
+
+  const bool file_select_gate_patch = ApplyGeneratedSourcePatch(
+      *file_select_chunk, "label_8017C8F8:",
+      "ctx->downcount -= 3;",
+      "ctx->downcount -= 3;\n"
+      "    if (ppc_host_call(ctx, 0x4D474B01u))\n"
+      "        goto label_8017C904;",
+      "RMGE01 FileSelector::exeTitleEnd gate");
+  return file_select_gate_patch && DisableAutomaticHostDispatch(emitted_header);
+}

+void InstallShaderCacheSeed(const fs::path& application_directory,
+                            const fs::path& user_directory)
+{
+  const fs::path source = application_directory / "ShaderCache";
+  if (!fs::is_directory(source))
+    return;
+
+  const fs::path destination = user_directory / "Cache";
+  std::error_code ec;
+  for (fs::recursive_directory_iterator it(source, ec), end; !ec && it != end;
+       it.increment(ec))
+  {
+    if (!it->is_regular_file(ec) || ec || it->path().extension() != ".uidcache")
+      continue;
+
+    const fs::path relative = fs::relative(it->path(), source, ec);
+    if (ec)
+      break;
+    const fs::path target = destination / relative;
+    const std::uintmax_t source_size = it->file_size(ec);
+    if (ec || !IsCompatiblePipelineUidCache(it->path()))
+      break;
+
+    fs::create_directories(target.parent_path(), ec);
+    if (ec)
+      break;
+    std::uintmax_t target_size = 0;
+    std::error_code target_error;
+    const bool target_exists = fs::is_regular_file(target, target_error);
+    if (target_exists)
+    {
+      target_size = fs::file_size(target, target_error);
+      if (target_error)
+        target_size = 0;
+    }
+    if (target_exists && IsCompatiblePipelineUidCache(target) && target_size >= source_size)
+      continue;
+
+    fs::copy_file(it->path(), target, fs::copy_options::overwrite_existing, ec);
+    if (ec)
+      break;
+  }
+
+  if (ec)
+    std::cerr << "Could not install the shader cache seed: " << ec.message() << '\n';
+}

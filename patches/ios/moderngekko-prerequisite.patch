+
+bool CopyDirectoryContents(const fs::path& source, const fs::path& destination,
+                           bool require_existing_source, std::string* message)
+{
+  std::error_code ec;
+  if (!fs::is_directory(source, ec))
+  {
+    if (message)
+      *message = require_existing_source ? "save directory not found: " + source.string() :
+                                           "selected path is not a directory";
+    return false;
+  }
+  const fs::path staging = destination.string() + ".copying";
+  fs::remove_all(staging, ec);
+  ec.clear();
+  fs::create_directories(staging, ec);
+  if (ec)
+  {
+    if (message)
+      *message = "can't create destination: " + ec.message();
+    return false;
+  }
+  fs::copy(source, staging,
+           fs::copy_options::recursive | fs::copy_options::overwrite_existing, ec);
+  if (ec)
+  {
+    if (message)
+      *message = "save copy failed: " + ec.message();
+    return false;
+  }
+  fs::remove_all(destination, ec);
+  ec.clear();
+  fs::rename(staging, destination, ec);
+  if (ec)
+  {
+    if (message)
+      *message = "can't publish save copy: " + ec.message();
+    return false;
+  }
+  if (message)
+    *message = "Save copied to " + destination.string();
+  return true;
+}

+void OnScreenUI::DrawControllerSettings()
+{
+  ImGui::TextUnformatted("Galaxy controller profile");
+  ImGui::TextDisabled("Wii Remote + Nunchuk behavior is translated to a standard gamepad.");
+  ImGui::Spacing();
+
+  if (ImGui::BeginTable("ControllerMap", 2,
+                        ImGuiTableFlags_RowBg | ImGuiTableFlags_BordersInnerH |
+                            ImGuiTableFlags_SizingStretchProp))
+  {
+    const char* const bindings[][2] = {{"Move", "Left stick"},
+                                       {"Star pointer", "Right stick or controller motion"},
+                                       {"Jump / confirm", "A / Cross"},
+                                       {"Crouch / back", "B / Circle or right trigger"},
+                                       {"Spin / shake", "X / Square"},
+                                       {"Camera reset (C)", "Left shoulder"},
+                                       {"Crouch (Z)", "Left trigger"},
+                                       {"Pause", "Menu / Options"}};
+    for (const auto& binding : bindings)
+    {
+      ImGui::TableNextRow();
+      ImGui::TableSetColumnIndex(0);
+      ImGui::TextUnformatted(binding[0]);
+      ImGui::TableSetColumnIndex(1);
+      ImGui::TextUnformatted(binding[1]);
+    }
+    ImGui::EndTable();
+  }
+
+  ImGui::Spacing();
+  ImGui::Separator();
+  ImGui::TextUnformatted("PC profile tuning");
+  ImGui::TextDisabled("Changes are written to the controller profile on the next launch.");
+
+  static constexpr const char* layouts[] = {"PC / Xbox / PlayStation",
+                                             "Nintendo face buttons"};
+  int layout = Config::Get(Config::MAIN_STATICRECOMP_CONTROLLER_LAYOUT) == 1 ? 1 : 0;
+  ImGui::SetNextItemWidth(310.0f);
+  if (ImGui::Combo("Face-button layout", &layout, layouts, IM_ARRAYSIZE(layouts)))
+    Config::SetBaseOrCurrent(Config::MAIN_STATICRECOMP_CONTROLLER_LAYOUT,
+                             static_cast<u32>(layout));
+
+  float movement_deadzone = Config::Get(Config::MAIN_STATICRECOMP_MOVE_DEADZONE);
+  if (ImGui::SliderFloat("Movement deadzone", &movement_deadzone, 0.0f, 35.0f, "%.0f%%"))
+    Config::SetBaseOrCurrent(Config::MAIN_STATICRECOMP_MOVE_DEADZONE, movement_deadzone);
+
+  float pointer_deadzone = Config::Get(Config::MAIN_STATICRECOMP_POINTER_DEADZONE);
+  if (ImGui::SliderFloat("Pointer deadzone", &pointer_deadzone, 0.0f, 35.0f, "%.0f%%"))
+    Config::SetBaseOrCurrent(Config::MAIN_STATICRECOMP_POINTER_DEADZONE, pointer_deadzone);
+
+  float pointer_sensitivity = Config::Get(Config::MAIN_STATICRECOMP_POINTER_SENSITIVITY);
+  if (ImGui::SliderFloat("Pointer speed", &pointer_sensitivity, 0.25f, 3.0f, "%.2fx"))
+    Config::SetBaseOrCurrent(Config::MAIN_STATICRECOMP_POINTER_SENSITIVITY,
+                             pointer_sensitivity);
+
+  bool gyro_enabled = Config::Get(Config::MAIN_STATICRECOMP_GYRO_ENABLED);
+  if (ImGui::Checkbox("DualShock / DualSense motion", &gyro_enabled))
+    Config::SetBaseOrCurrent(Config::MAIN_STATICRECOMP_GYRO_ENABLED, gyro_enabled);
+  ImGui::BeginDisabled(!gyro_enabled);
+  float gyro_deadzone = Config::Get(Config::MAIN_STATICRECOMP_GYRO_DEADZONE);
+  if (ImGui::SliderFloat("Gyro deadzone", &gyro_deadzone, 0.0f, 20.0f, "%.1f deg/s"))
+    Config::SetBaseOrCurrent(Config::MAIN_STATICRECOMP_GYRO_DEADZONE, gyro_deadzone);
+  int gyro_calibration = static_cast<int>(
+      Config::Get(Config::MAIN_STATICRECOMP_GYRO_CALIBRATION_PERIOD));
+  if (ImGui::SliderInt("Gyro calibration", &gyro_calibration, 0, 10, "%d s"))
+  {
+    Config::SetBaseOrCurrent(Config::MAIN_STATICRECOMP_GYRO_CALIBRATION_PERIOD,
+                             static_cast<u32>(gyro_calibration));
+  }
+  ImGui::EndDisabled();
+
+  ImGui::Spacing();
+  ImGui::TextWrapped("Xbox, DualShock and DualSense controllers use the same profile. When SDL "
+                     "exposes gyro and accelerometer sensors, motion is passed through alongside "
+                     "the right-stick pointer fallback. Press the right stick to recenter.");
+}

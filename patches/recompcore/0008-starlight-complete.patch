+bool IsGuestRamRange(Memory::MemoryManager& memory, u32 address, u32 size)
+{
+  if (size == 0 || (address & 0x80000000u) == 0)
+    return false;
+
+  const u32 physical = address & 0x3FFFFFFFu;
+  const u32 ram_size = memory.GetRamSizeReal();
+  if (physical < ram_size && size <= ram_size - physical)
+    return true;
+
+  constexpr u32 exram_base = 0x10000000u;
+  const u32 exram_size = memory.GetExRamSizeReal();
+  return physical >= exram_base && physical - exram_base < exram_size &&
+         size <= exram_size - (physical - exram_base);

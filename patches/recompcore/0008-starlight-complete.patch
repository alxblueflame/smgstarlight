+void OnScreenUI::DrawDisplaySettings()
+{
+  ImGui::TextUnformatted("Output");
+  ImGui::TextDisabled("Resolution and presentation changes apply while the game is running.");
+  ImGui::Spacing();
+
+  static const char* const resolutions[] = {"Auto (window size)", "Native (640 x 528)",
+                                            "2x (1280 x 1056)",   "3x (1920 x 1584)",
+                                            "4x (2560 x 2112)",   "5x (3200 x 2640)",
+                                            "6x (3840 x 3168)"};
+  int scale = Config::Get(Config::GFX_EFB_SCALE);
+  if (scale < 0 || scale >= IM_ARRAYSIZE(resolutions))
+    scale = 0;
+  ImGui::SetNextItemWidth(310.0f);
+  if (ImGui::Combo("Internal resolution", &scale, resolutions, IM_ARRAYSIZE(resolutions)))
+    Config::SetBaseOrCurrent(Config::GFX_EFB_SCALE, scale);
+  static const char* const aspects[] = {"Auto", "Stretch", "4:3", "16:9", "21:9 ultrawide",
+                                        "32:9 super ultrawide"};
+  const AspectMode current_aspect = Config::Get(Config::GFX_ASPECT_RATIO);
+  int aspect = 2;
+  if (current_aspect == AspectMode::Auto)
+    aspect = 0;
+  else if (current_aspect == AspectMode::Stretch)
+    aspect = 1;
+  else if (current_aspect == AspectMode::ForceStandard)
+    aspect = 2;
+  else if (current_aspect == AspectMode::ForceWide)
+    aspect = 3;
+  else if (current_aspect == AspectMode::Custom)
+  {
+    const int width = Config::Get(Config::GFX_CUSTOM_ASPECT_RATIO_WIDTH);
+    aspect = width >= 32 ? 5 : 4;
+  }
+  ImGui::SetNextItemWidth(310.0f);
+  if (ImGui::Combo("Aspect ratio", &aspect, aspects, IM_ARRAYSIZE(aspects)))
+  {
+    if (aspect == 0)
+      Config::SetBaseOrCurrent(Config::GFX_ASPECT_RATIO, AspectMode::Auto);
+    else if (aspect == 1)
+      Config::SetBaseOrCurrent(Config::GFX_ASPECT_RATIO, AspectMode::Stretch);
+    else if (aspect == 2)
+      Config::SetBaseOrCurrent(Config::GFX_ASPECT_RATIO, AspectMode::ForceStandard);
+    else if (aspect == 3)
+      Config::SetBaseOrCurrent(Config::GFX_ASPECT_RATIO, AspectMode::ForceWide);
+    else
+    {
+      Config::SetBaseOrCurrent(Config::GFX_ASPECT_RATIO, AspectMode::Custom);
+      Config::SetBaseOrCurrent(Config::GFX_CUSTOM_ASPECT_RATIO_WIDTH, aspect == 4 ? 21 : 32);
+      Config::SetBaseOrCurrent(Config::GFX_CUSTOM_ASPECT_RATIO_HEIGHT, 9);
+      Config::SetBaseOrCurrent(Config::GFX_WIDESCREEN_HACK, true);
+    }
+  }
+
+  bool fullscreen = Config::Get(Config::MAIN_FULLSCREEN);
+  if (ImGui::Checkbox("Borderless fullscreen on next launch", &fullscreen))
+    Config::SetBaseOrCurrent(Config::MAIN_FULLSCREEN, fullscreen);
+  ImGui::SameLine();
+  ImGui::TextDisabled("(F11 / Alt+Enter now)");
+
+  bool vsync = Config::Get(Config::GFX_VSYNC);
+  if (ImGui::Checkbox("Vertical sync", &vsync))
+    Config::SetBaseOrCurrent(Config::GFX_VSYNC, vsync);
+
+  bool show_metrics = Config::Get(Config::GFX_SHOW_FPS);
+  if (ImGui::Checkbox("Performance overlay", &show_metrics))
+  {
+    Config::SetBaseOrCurrent(Config::GFX_SHOW_FPS, show_metrics);
+    Config::SetBaseOrCurrent(Config::GFX_SHOW_SPEED, show_metrics);
+  }
+}
+
+void OnScreenUI::DrawGraphicsSettings()
+{
+  ImGui::TextUnformatted("Image quality");
+  ImGui::TextDisabled("Features here preserve the original rendering unless explicitly enabled.");
+  ImGui::Spacing();
+
+  bool widescreen = Config::Get(Config::GFX_WIDESCREEN_HACK);
+  if (ImGui::Checkbox("Experimental widescreen expansion", &widescreen))
+    Config::SetBaseOrCurrent(Config::GFX_WIDESCREEN_HACK, widescreen);
+  if (ImGui::IsItemHovered())
+    ImGui::SetTooltip("Expands 3D geometry beyond the original view; some scenes may show artifacts.");
+
+  static const char* const anti_aliasing[] = {"Off", "2x MSAA", "4x MSAA", "8x MSAA"};
+  const u32 current_msaa = Config::Get(Config::GFX_MSAA);
+  int msaa_index = current_msaa >= 8 ? 3 : current_msaa >= 4 ? 2 : current_msaa >= 2 ? 1 : 0;
+  ImGui::SetNextItemWidth(310.0f);
+  if (ImGui::Combo("Anti-aliasing", &msaa_index, anti_aliasing, IM_ARRAYSIZE(anti_aliasing)))
+  {
+    Config::SetBaseOrCurrent(Config::GFX_MSAA, 1u << msaa_index);
+    if (msaa_index != 0)
+      Config::SetBaseOrCurrent(Config::MAIN_STATICRECOMP_INTERPOLATION, false);
+  }
+
+  bool ssaa = Config::Get(Config::GFX_SSAA);
+  ImGui::BeginDisabled(msaa_index == 0);
+  if (ImGui::Checkbox("Supersample anti-aliasing", &ssaa))
+  {
+    Config::SetBaseOrCurrent(Config::GFX_SSAA, ssaa);
+    if (ssaa)
+      Config::SetBaseOrCurrent(Config::MAIN_STATICRECOMP_INTERPOLATION, false);
+  }
+  ImGui::EndDisabled();
+
+  bool true_color = Config::Get(Config::GFX_ENHANCE_FORCE_TRUE_COLOR);
+  if (ImGui::Checkbox("True-color rendering", &true_color))
+    Config::SetBaseOrCurrent(Config::GFX_ENHANCE_FORCE_TRUE_COLOR, true_color);
+
+  bool disable_copy_filter = Config::Get(Config::GFX_ENHANCE_DISABLE_COPY_FILTER);
+  if (ImGui::Checkbox("Disable original blur filter", &disable_copy_filter))
+    Config::SetBaseOrCurrent(Config::GFX_ENHANCE_DISABLE_COPY_FILTER, disable_copy_filter);
+  if (ImGui::IsItemHovered())
+    ImGui::SetTooltip("Produces a sharper image by removing the Wii copy filter.");
+
+  bool disable_fog = Config::Get(Config::GFX_DISABLE_FOG);
+  if (ImGui::Checkbox("Disable fog", &disable_fog))
+    Config::SetBaseOrCurrent(Config::GFX_DISABLE_FOG, disable_fog);
+  if (ImGui::IsItemHovered())
+    ImGui::SetTooltip("Host graphics mod. Some galaxies use fog as part of their intended look.");
+
+  bool hires = Config::Get(Config::GFX_HIRES_TEXTURES);
+  if (ImGui::Checkbox("Load custom HD textures", &hires))
+    Config::SetBaseOrCurrent(Config::GFX_HIRES_TEXTURES, hires);
+
+  bool cache_hires = Config::Get(Config::GFX_CACHE_HIRES_TEXTURES);
+  ImGui::BeginDisabled(!hires);
+  if (ImGui::Checkbox("Preload HD textures into memory", &cache_hires))
+    Config::SetBaseOrCurrent(Config::GFX_CACHE_HIRES_TEXTURES, cache_hires);
+  ImGui::EndDisabled();
+  if (ImGui::IsItemHovered())
+    ImGui::SetTooltip("Reduces texture pop-in but can use a large amount of RAM.");
+
+  static const char* const filtering[] = {"Game controlled", "Nearest", "Linear"};
+  int texture_filtering =
+      static_cast<int>(Config::Get(Config::GFX_ENHANCE_FORCE_TEXTURE_FILTERING));
+  if (texture_filtering < 0 || texture_filtering >= IM_ARRAYSIZE(filtering))
+    texture_filtering = 0;
+  ImGui::SetNextItemWidth(310.0f);
+  if (ImGui::Combo("Texture filtering", &texture_filtering, filtering,
+                   IM_ARRAYSIZE(filtering)))
+  {
+    Config::SetBaseOrCurrent(Config::GFX_ENHANCE_FORCE_TEXTURE_FILTERING,
+                             static_cast<TextureFilteringMode>(texture_filtering));
+  }
+
+  static const char* const anisotropy[] = {"Game controlled", "1x", "2x", "4x", "8x", "16x"};
+  int anisotropy_index =
+      static_cast<int>(Config::Get(Config::GFX_ENHANCE_MAX_ANISOTROPY)) + 1;
+  if (anisotropy_index < 0 || anisotropy_index >= IM_ARRAYSIZE(anisotropy))
+    anisotropy_index = 0;
+  ImGui::SetNextItemWidth(310.0f);
+  if (ImGui::Combo("Anisotropic filtering", &anisotropy_index, anisotropy,
+                   IM_ARRAYSIZE(anisotropy)))
+  {
+    Config::SetBaseOrCurrent(Config::GFX_ENHANCE_MAX_ANISOTROPY,
+                             static_cast<AnisotropicFilteringMode>(anisotropy_index - 1));
+  }
+
+#ifdef _WIN32
+  if (ImGui::Button("Open HD texture folder"))
+  {
+    std::string texture_path = File::GetUserPath(D_LOAD_IDX) + "Textures/RMGE01/";
+    File::CreateFullPath(texture_path);
+    for (char& c : texture_path)
+      if (c == '/')
+        c = '\\';
+    std::system(("explorer \"" + texture_path + "\"").c_str());
+  }
+#endif
+}
+
+void OnScreenUI::DrawModSettings()
+{
+  ImGui::TextUnformatted("Game-side mods");
+  ImGui::TextDisabled("These hooks alter RMGE01 game flow or actor presentation.");
+  ImGui::Spacing();
+
+  bool custom_frontend = Config::Get(Config::MAIN_STATICRECOMP_CUSTOM_FRONTEND);
+  if (ImGui::Checkbox("PC menu before file select", &custom_frontend))
+    Config::SetBaseOrCurrent(Config::MAIN_STATICRECOMP_CUSTOM_FRONTEND, custom_frontend);
+
+  bool hide_actors = Config::Get(Config::MAIN_STATICRECOMP_HIDE_FILE_SELECT_ACTORS);
+  if (ImGui::Checkbox("Hide native file-select interface behind PC menu", &hide_actors))
+    Config::SetBaseOrCurrent(Config::MAIN_STATICRECOMP_HIDE_FILE_SELECT_ACTORS, hide_actors);
+  if (ImGui::IsItemHovered())
+    ImGui::SetTooltip("Keeps the rocks, portraits, numbers, prompts and pointer hidden until PLAY.");
+
+  ImGui::Separator();
+  ImGui::TextUnformatted("Host-side mods");
+  ImGui::TextDisabled("These affect the PC renderer without changing simulation.");
+  ImGui::Spacing();
+
+  bool smooth_presentation = Config::Get(Config::MAIN_SMOOTH_EARLY_PRESENTATION);
+  if (ImGui::Checkbox("Smooth 60 Hz frame pacing", &smooth_presentation))
+    Config::SetBaseOrCurrent(Config::MAIN_SMOOTH_EARLY_PRESENTATION, smooth_presentation);
+
+  bool skip_duplicates = Config::Get(Config::GFX_HACK_SKIP_DUPLICATE_XFBS);
+  if (ImGui::Checkbox("Skip duplicate video frames", &skip_duplicates))
+    Config::SetBaseOrCurrent(Config::GFX_HACK_SKIP_DUPLICATE_XFBS, skip_duplicates);
+
+  ImGui::Separator();
+  ImGui::TextUnformatted("High-refresh presentation");
+  bool interpolation = Config::Get(Config::MAIN_STATICRECOMP_INTERPOLATION);
+  if (ImGui::Checkbox("Inter-frame interpolation", &interpolation))
+  {
+    Config::SetBaseOrCurrent(Config::MAIN_STATICRECOMP_INTERPOLATION, interpolation);
+    if (interpolation)
+    {
+      Config::SetBaseOrCurrent(Config::GFX_VSYNC, false);
+      Config::SetBaseOrCurrent(Config::GFX_MSAA, 1u);
+      Config::SetBaseOrCurrent(Config::GFX_SSAA, false);
+    }
+  }
+
+  static const char* const interpolation_rates[] = {"90 FPS", "120 FPS", "144 FPS",
+                                                    "165 FPS", "240 FPS", "360 FPS"};
+  static constexpr u32 interpolation_rate_values[] = {90, 120, 144, 165, 240, 360};
+  u32 rate = Config::Get(Config::MAIN_STATICRECOMP_INTERPOLATION_RATE);
+  int rate_index = 1;
+  for (int i = 0; i < IM_ARRAYSIZE(interpolation_rate_values); ++i)
+  {
+    if (rate == interpolation_rate_values[i])
+      rate_index = i;
+  }
+  ImGui::BeginDisabled(!interpolation);
+  ImGui::SetNextItemWidth(220.0f);
+  if (ImGui::Combo("Presentation rate", &rate_index, interpolation_rates,
+                   IM_ARRAYSIZE(interpolation_rates)))
+  {
+    Config::SetBaseOrCurrent(Config::MAIN_STATICRECOMP_INTERPOLATION_RATE,
+                             interpolation_rate_values[rate_index]);
+  }
+  ImGui::EndDisabled();
+  ImGui::TextWrapped("Generates paced temporal blends between consecutive 60 Hz game frames. The "
+                     "effective output is limited to the active display refresh so unsupported "
+                     "rates cannot consume GPU time or cause flashing. Gameplay, input and audio "
+                     "remain synchronized to the original simulation rate.");
+}
+
+void OnScreenUI::DrawPerformanceSettings()
+{
+  ImGui::TextUnformatted("Performance profile");
+  ImGui::TextDisabled("These presets change GPU cost, not the speed of the game simulation.");
+  ImGui::Spacing();
+
+  if (ImGui::Button("Performance", ImVec2(150.0f, 34.0f)))
+  {
+    Config::SetBaseOrCurrent(Config::GFX_EFB_SCALE, 1);
+    Config::SetBaseOrCurrent(Config::GFX_MSAA, 1u);
+    Config::SetBaseOrCurrent(Config::GFX_SSAA, false);
+    Config::SetBaseOrCurrent(Config::GFX_HIRES_TEXTURES, false);
+    Config::SetBaseOrCurrent(Config::GFX_CACHE_HIRES_TEXTURES, false);
+    Config::SetBaseOrCurrent(Config::GFX_SHADER_COMPILATION_MODE,
+                              ShaderCompilationMode::AsynchronousUberShaders);
+    Config::SetBaseOrCurrent(Config::GFX_BACKEND_MULTITHREADING, true);
+  }
+  ImGui::SameLine();
+  if (ImGui::Button("Balanced", ImVec2(150.0f, 34.0f)))
+  {
+    Config::SetBaseOrCurrent(Config::GFX_EFB_SCALE, 2);
+    Config::SetBaseOrCurrent(Config::GFX_MSAA, 1u);
+    Config::SetBaseOrCurrent(Config::GFX_SSAA, false);
+    Config::SetBaseOrCurrent(Config::GFX_CACHE_HIRES_TEXTURES, false);
+    Config::SetBaseOrCurrent(Config::GFX_SHADER_COMPILATION_MODE,
+                             ShaderCompilationMode::AsynchronousUberShaders);
+    Config::SetBaseOrCurrent(Config::GFX_BACKEND_MULTITHREADING, true);
+  }
+  ImGui::SameLine();
+  if (ImGui::Button("High quality", ImVec2(150.0f, 34.0f)))
+  {
+    Config::SetBaseOrCurrent(Config::GFX_EFB_SCALE, 3);
+    Config::SetBaseOrCurrent(Config::GFX_SHADER_COMPILATION_MODE,
+                             ShaderCompilationMode::AsynchronousUberShaders);
+    Config::SetBaseOrCurrent(Config::GFX_BACKEND_MULTITHREADING, true);
+  }
+
+  static const char* const shader_modes[] = {"Specialized (may stutter)",
+                                             "Exclusive ubershaders",
+                                             "Hybrid ubershaders (recommended)",
+                                             "Skip rendering while compiling"};
+  int shader_mode = static_cast<int>(Config::Get(Config::GFX_SHADER_COMPILATION_MODE));
+  if (shader_mode < 0 || shader_mode >= IM_ARRAYSIZE(shader_modes))
+    shader_mode = 2;
+  ImGui::SetNextItemWidth(310.0f);
+  if (ImGui::Combo("Shader compilation", &shader_mode, shader_modes,
+                   IM_ARRAYSIZE(shader_modes)))
+  {
+    Config::SetBaseOrCurrent(Config::GFX_SHADER_COMPILATION_MODE,
+                             static_cast<ShaderCompilationMode>(shader_mode));
+  }
+
+  bool backend_mt = Config::Get(Config::GFX_BACKEND_MULTITHREADING);
+  if (ImGui::Checkbox("Multithreaded graphics backend", &backend_mt))
+    Config::SetBaseOrCurrent(Config::GFX_BACKEND_MULTITHREADING, backend_mt);
+
+  bool hybrid = Config::Get(Config::MAIN_STATICRECOMP_HYBRID_PERFORMANCE);
+  if (ImGui::Checkbox("Stable gameplay core after PLAY (recommended)", &hybrid))
+    Config::SetBaseOrCurrent(Config::MAIN_STATICRECOMP_HYBRID_PERFORMANCE, hybrid);
+  if (ImGui::IsItemHovered())
+  {
+    ImGui::SetTooltip("Keeps the recompiled boot and PC frontend, then uses the optimized CPU "
+                      "core for stable gameplay. Disable this for pure static-recomp testing.");
+  }
+
+  const float simulation_speed = Config::Get(Config::MAIN_EMULATION_SPEED);
+  ImGui::Separator();
+  ImGui::TextUnformatted("Game simulation");
+  if (simulation_speed == 1.0f)
+    ImGui::TextColored(ImVec4(0.40f, 0.86f, 0.56f, 1.00f), "100%% - original timing");
+  else
+  {
+    ImGui::TextColored(ImVec4(1.00f, 0.65f, 0.25f, 1.00f),
+                       "Non-standard speed: %.2fx", simulation_speed);
+    ImGui::SameLine();
+    if (ImGui::SmallButton("Restore 100%"))
+      Config::SetBaseOrCurrent(Config::MAIN_EMULATION_SPEED, 1.0f);
+  }
+  ImGui::TextWrapped("The recompiled PPC game remains a 60 Hz simulation. High-refresh output "
+                     "requires presentation interpolation; removing the speed limit would make "
+                     "gameplay and audio run faster.");
+}

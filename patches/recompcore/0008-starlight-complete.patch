+                 u32 address)
+{
+  if (address == 0)
+    return;
+  if (!saved.contains(address))
+    saved.emplace(address, memory.Read_U8(address));
+  memory.Write_U8(1, address);
+}
+
+void SaveAndHideActor(Memory::MemoryManager& memory, std::unordered_map<u32, u8>& saved,
+                       u32 actor, u32 flag_offset)
+{
+  if (actor != 0)
+    SaveAndHide(memory, saved, actor + flag_offset);
+}
+
+}
+
+bool StaticRecompCore::HookHostCall(CPUState* cpu, u32 address)
+{
+  if (cpu == nullptr || cpu->external_user_data == nullptr)
+    return false;
+
+  auto* core = static_cast<StaticRecompCore*>(cpu->external_user_data);
+  if (address == RMGE01_TITLE_CONFIRM_GATE)
+    return FrontendInput::IsTitleConfirmed();
+  if (address == RMGE01_FILE_SELECT_PREPARE)
+  {
+    core->PrepareFileSelect(cpu);
+    return false;
+  }
+  return address == RMGE01_FILE_SELECT_GATE && core->HandleFileSelectGate(cpu);
+}
+
+bool StaticRecompCore::PrepareFileSelect(CPUState* cpu)
+{
+  if (!Config::Get(Config::MAIN_STATICRECOMP_CUSTOM_FRONTEND))
+  {
+    RestoreFileSelectActors();
+    if (FrontendInput::IsFileSelectCaptured())
+      FrontendInput::ReleaseFileSelect();
+    return false;
+  }
+
+  if (FrontendInput::IsFileSelectReleased())
+  {
+    RestoreFileSelectActors();
+    return false;
+  }
+
+  if (!FrontendInput::IsFileSelectCaptured())
+    FrontendInput::CaptureFileSelect();
+
+  if (Config::Get(Config::MAIN_STATICRECOMP_HIDE_FILE_SELECT_ACTORS))
+  {
+    if (!HideFileSelectActors(cpu->gpr[31], cpu->gpr[13]))
+    {
+      std::fprintf(
+          stderr,
+          "[staticrecomp] RMGE01 file selector graph validation failed; using native menu\n");
+      RestoreFileSelectActors();
+      FrontendInput::ReleaseFileSelect();
+      return false;
+    }
+  }
+  else
+  {
+    RestoreFileSelectActors();
+  }
+
+  return true;
+}
+
+bool StaticRecompCore::HandleFileSelectGate(CPUState* cpu)
+{
+  if (FrontendInput::IsFileSelectReleased())
+  {
+    RestoreFileSelectActors();
+    return false;
+  }
+
+  if (FrontendInput::IsFileSelectReady())
+  {
+    if (Config::Get(Config::MAIN_STATICRECOMP_HIDE_FILE_SELECT_ACTORS) &&
+        !HideFileSelectActors(cpu->gpr[31], cpu->gpr[13]))
+    {
+      RestoreFileSelectActors();
+      FrontendInput::ReleaseFileSelect();
+      return false;
+    }
+    return true;
+  }
+
+  if (!PrepareFileSelect(cpu))
+    return false;
+
+  FrontendInput::MarkFileSelectReady();
+  return true;
+}
+
+bool StaticRecompCore::HideFileSelectActors(u32 selector, u32 small_data_area)
+{
+  if (selector == m_file_selector && !m_file_select_visibility.empty())
+  {
+    auto& memory = m_system.GetMemory();
+    for (const auto& entry : m_file_select_visibility)
+      memory.Write_U8(1, entry.first);
+    return true;
+  }
+
+  auto& memory = m_system.GetMemory();
+  if (!IsGuestRamRange(memory, selector, 0xF0))
+    return false;
+
+  const u32 group = memory.Read_U32(selector + FILE_SELECTOR_ITEMS_OFFSET);
+  if (!IsGuestRamRange(memory, group, NAME_OBJ_GROUP_OBJECTS_OFFSET + sizeof(u32)) ||
+      memory.Read_U32(group + NAME_OBJ_GROUP_COUNT_OFFSET) != FILE_SELECT_ITEM_COUNT)
+  {
+    return false;
+  }
+
+  const u32 objects = memory.Read_U32(group + NAME_OBJ_GROUP_OBJECTS_OFFSET);
+  if (!IsGuestRamRange(memory, objects, FILE_SELECT_ITEM_COUNT * sizeof(u32)))
+    return false;
+
+  std::array<FileSelectItemGraph, FILE_SELECT_ITEM_COUNT> items{};
+  u32 seen_indices = 0;
+  for (u32 i = 0; i < FILE_SELECT_ITEM_COUNT; ++i)
+  {
+    FileSelectItemGraph& graph = items[i];
+    graph.item = memory.Read_U32(objects + i * sizeof(u32));
+    if (!IsGuestRamRange(memory, graph.item, 0x170))
+      return false;
+
+    const u32 item_index = memory.Read_U32(graph.item + FILE_SELECT_ITEM_INDEX_OFFSET);
+    if (item_index < 1 || item_index > FILE_SELECT_ITEM_COUNT ||
+        (seen_indices & (1u << (item_index - 1))) != 0)
+    {
+      return false;
+    }
+    seen_indices |= 1u << (item_index - 1);
+
+    const u32 delegator = memory.Read_U32(graph.item + FILE_SELECT_ITEM_DELEGATOR_OFFSET);
+    if (!IsGuestRamRange(memory, delegator, FILE_SELECT_DELEGATOR_SELECTOR_OFFSET + sizeof(u32)) ||
+        memory.Read_U32(delegator + FILE_SELECT_DELEGATOR_SELECTOR_OFFSET) != selector)
+    {
+      return false;
+    }
+
+    graph.planet = memory.Read_U32(graph.item + FILE_SELECT_ITEM_PLANET_OFFSET);
+    const u32 models = memory.Read_U32(graph.item + FILE_SELECT_ITEM_MODELS_OFFSET);
+    graph.face = memory.Read_U32(graph.item + FILE_SELECT_ITEM_MII_FACE_OFFSET);
+    graph.number = memory.Read_U32(graph.item + FILE_SELECT_ITEM_NUMBER_OFFSET);
+    if (!IsOptionalActor(memory, graph.planet, LIVE_ACTOR_HIDDEN_MODEL_OFFSET) ||
+        !IsGuestRamRange(memory, models,
+                         static_cast<u32>(graph.models.size() * sizeof(u32))) ||
+        !IsOptionalActor(memory, graph.face, LIVE_ACTOR_HIDDEN_MODEL_OFFSET) ||
+        !IsOptionalActor(memory, graph.number, LAYOUT_ACTOR_HIDDEN_OFFSET))
+    {
+      return false;
+    }
+
+    for (u32 model_index = 0; model_index < graph.models.size(); ++model_index)
+    {
+      graph.models[model_index] = memory.Read_U32(models + model_index * sizeof(u32));
+      if (!IsOptionalActor(memory, graph.models[model_index], LIVE_ACTOR_HIDDEN_MODEL_OFFSET))
+        return false;
+    }
+  }
+
+  std::array<u32, FILE_SELECTOR_LAYOUT_OFFSETS.size()> layouts{};
+  for (u32 i = 0; i < layouts.size(); ++i)
+  {
+    layouts[i] = memory.Read_U32(selector + FILE_SELECTOR_LAYOUT_OFFSETS[i]);
+    if (!IsOptionalActor(memory, layouts[i], LAYOUT_ACTOR_HIDDEN_OFFSET))
+      return false;
+  }
+
+  const u32 select_effect = memory.Read_U32(selector + FILE_SELECTOR_SELECT_EFFECT_OFFSET);
+  if (!IsOptionalActor(memory, select_effect, LIVE_ACTOR_HIDDEN_MODEL_OFFSET))
+    return false;
+
+  if (!IsGuestRamRange(memory, small_data_area - GAME_SYSTEM_SINGLETON_SDA_OFFSET,
+                       sizeof(u32)))
+  {
+    return false;
+  }
+  const u32 game_system =
+      memory.Read_U32(small_data_area - GAME_SYSTEM_SINGLETON_SDA_OFFSET);
+  if (!IsGuestRamRange(memory, game_system, GAME_SYSTEM_OBJ_HOLDER_OFFSET + sizeof(u32)))
+    return false;
+  const u32 object_holder = memory.Read_U32(game_system + GAME_SYSTEM_OBJ_HOLDER_OFFSET);
+  if (!IsGuestRamRange(memory, object_holder,
+                       GAME_SYSTEM_STAR_POINTER_DIRECTOR_OFFSET + sizeof(u32)))
+  {
+    return false;
+  }
+  const u32 star_pointer_director =
+      memory.Read_U32(object_holder + GAME_SYSTEM_STAR_POINTER_DIRECTOR_OFFSET);
+  if (!IsGuestRamRange(memory, star_pointer_director,
+                       STAR_POINTER_DIRECTOR_GUIDANCE_OFFSET + sizeof(u32)))
+  {
+    return false;
+  }
+  const u32 star_pointer_guidance =
+      memory.Read_U32(star_pointer_director + STAR_POINTER_DIRECTOR_GUIDANCE_OFFSET);
+  if (!IsOptionalActor(memory, star_pointer_guidance, LAYOUT_ACTOR_HIDDEN_OFFSET))
+    return false;
+
+  RestoreFileSelectActors();
+  m_file_selector = selector;
+  for (const FileSelectItemGraph& graph : items)
+  {
+    SaveAndHideActor(memory, m_file_select_visibility, graph.item,
+                     LIVE_ACTOR_HIDDEN_MODEL_OFFSET);
+    SaveAndHideActor(memory, m_file_select_visibility, graph.planet,
+                     LIVE_ACTOR_HIDDEN_MODEL_OFFSET);
+    for (const u32 model : graph.models)
+      SaveAndHideActor(memory, m_file_select_visibility, model,
+                       LIVE_ACTOR_HIDDEN_MODEL_OFFSET);
+    SaveAndHideActor(memory, m_file_select_visibility, graph.face,
+                     LIVE_ACTOR_HIDDEN_MODEL_OFFSET);
+    SaveAndHideActor(memory, m_file_select_visibility, graph.number, LAYOUT_ACTOR_HIDDEN_OFFSET);
+  }
+  for (const u32 layout : layouts)
+    SaveAndHideActor(memory, m_file_select_visibility, layout, LAYOUT_ACTOR_HIDDEN_OFFSET);
+  SaveAndHideActor(memory, m_file_select_visibility, select_effect,
+                   LIVE_ACTOR_HIDDEN_MODEL_OFFSET);
+  SaveAndHideActor(memory, m_file_select_visibility, star_pointer_guidance,
+                   LAYOUT_ACTOR_HIDDEN_OFFSET);
+
+  std::fprintf(stderr, "[staticrecomp] RMGE01 native file selector hidden (%zu flags)\n",
+               m_file_select_visibility.size());
+  return true;
+}
+
+void StaticRecompCore::RestoreFileSelectActors()
+{
+  if (m_file_select_visibility.empty())
+  {
+    m_file_selector = 0;
+    return;
+  }
+
+  auto& memory = m_system.GetMemory();
+  for (const auto& [address, value] : m_file_select_visibility)
+  {
+    if (IsGuestRamRange(memory, address, 1))
+      memory.Write_U8(value, address);
+  }
+  std::fprintf(stderr, "[staticrecomp] RMGE01 native file selector restored\n");
+  m_file_select_visibility.clear();
+  m_file_selector = 0;
 }
 

+std::string GenerateInterFrameVertexShader()
+{
+  ShaderCode code;
+  EmitUniformBufferDeclaration(code);
+  code.Write("{{\n"
+             "  float interpolation_alpha;\n"
+             "  float3 padding;\n"
+             "  float4 src_rect;\n"
+             "}};\n\n");
+  EmitVertexMainDeclaration(code, 0, 0, false, 1, 0, "#define id gl_VertexID\n");
+  code.Write(
+      "{{\n"
+      "  v_tex0 = float3(float((id << 1) & 2), float(id & 2), 0.0f);\n"
+      "  opos = float4(v_tex0.xy * float2(2.0f, -2.0f) + float2(-1.0f, 1.0f), 0.0f, 1.0f);\n"
+      "  v_tex0.xy = src_rect.xy + (src_rect.zw * v_tex0.xy);\n");
+  if (GetAPIType() == APIType::Vulkan)
+    code.Write("  opos.y = -opos.y;\n");
+  code.Write("}}\n");
+  return code.GetBuffer();
+}
+
+std::string GenerateInterFramePixelShader()
+{
+  ShaderCode code;
+  EmitUniformBufferDeclaration(code);
+  code.Write("{{\n"
+             "  float interpolation_alpha;\n"
+             "  float3 padding;\n"
+             "  float4 src_rect;\n"
+             "}};\n\n");
+  EmitSamplerDeclarations(code, 0, 2, false);
+  EmitPixelMainDeclaration(code, 1, 0);
+  code.Write("{{\n"
+             "  float4 previous_color = ");
+  EmitSampleTexture(code, 0, "v_tex0");
+  code.Write(";\n"
+             "  float4 current_color = ");
+  EmitSampleTexture(code, 1, "v_tex0");
+  code.Write(";\n"
+             "  ocol0 = lerp(previous_color, current_color, interpolation_alpha);\n"
+             "}}\n");
+  return code.GetBuffer();
+}

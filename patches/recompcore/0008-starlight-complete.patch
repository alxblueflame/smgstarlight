diff --git a/Source/Core/Common/FrontendInput.h b/Source/Core/Common/FrontendInput.h
new file mode 100644
index 0000000..8e2c219
--- /dev/null
+++ b/Source/Core/Common/FrontendInput.h
@@ -0,0 +1,134 @@
+#pragma once
+
+#include <atomic>
+
+#include "Common/CommonTypes.h"
+
+namespace FrontendInput
+{
+inline std::atomic<u16> s_buttons{0};
+inline std::atomic<bool> s_title_observed{false};
+inline std::atomic<bool> s_title_confirmed{false};
+inline std::atomic<bool> s_file_select_captured{false};
+inline std::atomic<bool> s_file_select_ready{false};
+inline std::atomic<bool> s_file_select_released{false};
+inline std::atomic<bool> s_file_select_input_blocked{false};
+inline std::atomic<int> s_rumble_ticks{-1};
+
+inline void Reset()
+{
+  s_buttons.store(0, std::memory_order_release);
+  s_title_observed.store(false, std::memory_order_release);
+  s_title_confirmed.store(false, std::memory_order_release);
+  s_file_select_captured.store(false, std::memory_order_release);
+  s_file_select_ready.store(false, std::memory_order_release);
+  s_file_select_released.store(false, std::memory_order_release);
+  s_file_select_input_blocked.store(false, std::memory_order_release);
+  s_rumble_ticks.store(-1, std::memory_order_release);
+}
+
+inline void PublishButtons(u16 buttons)
+{
+  s_buttons.store(buttons, std::memory_order_release);
+  if (buttons == 0 && s_file_select_released.load(std::memory_order_acquire))
+    s_file_select_input_blocked.store(false, std::memory_order_release);
+}
+
+inline u16 GetButtons()
+{
+  return s_buttons.load(std::memory_order_acquire);
+}
+
+inline void ObserveGuestPc(u32 pc)
+{
+  if ((pc >= 0x8038F084 && pc < 0x8038F418) ||
+      (pc >= 0x8017C7B4 && pc < 0x8017C874))
+    s_title_observed.store(true, std::memory_order_release);
+
+  if (s_title_observed.load(std::memory_order_acquire) && pc >= 0x8017C874 &&
+      pc < 0x8017D0A0 &&
+      !s_file_select_released.load(std::memory_order_acquire))
+  {
+    s_file_select_captured.store(true, std::memory_order_release);
+    s_file_select_input_blocked.store(true, std::memory_order_release);
+  }
+}
+
+inline bool IsFileSelectCaptured()
+{
+  return s_file_select_captured.load(std::memory_order_acquire);
+}
+
+inline bool HasObservedTitle()
+{
+  return s_title_observed.load(std::memory_order_acquire);
+}
+
+inline void ConfirmTitle()
+{
+  s_title_confirmed.store(true, std::memory_order_release);
+}
+
+inline bool IsTitleConfirmed()
+{
+  return s_title_confirmed.load(std::memory_order_acquire);
+}
+
+inline bool IsFileSelectReady()
+{
+  return s_file_select_ready.load(std::memory_order_acquire);
+}
+
+inline bool IsFileSelectReleased()
+{
+  return s_file_select_released.load(std::memory_order_acquire);
+}
+
+inline bool IsFileSelectInputBlocked()
+{
+  return s_file_select_input_blocked.load(std::memory_order_acquire);
+}
+
+inline void CaptureFileSelect()
+{
+  if (!s_file_select_released.load(std::memory_order_acquire))
+  {
+    s_file_select_captured.store(true, std::memory_order_release);
+    s_file_select_input_blocked.store(true, std::memory_order_release);
+  }
+}
+
+inline void MarkFileSelectReady()
+{
+  if (s_file_select_captured.load(std::memory_order_acquire))
+    s_file_select_ready.store(true, std::memory_order_release);
+}
+
+inline void ReleaseFileSelect()
+{
+  s_file_select_ready.store(false, std::memory_order_release);
+  s_file_select_released.store(true, std::memory_order_release);
+  s_file_select_captured.store(false, std::memory_order_release);
+}
+
+inline void RequestRumble(int ticks)
+{
+  s_rumble_ticks.store(ticks, std::memory_order_release);
+}
+
+inline int ConsumeRumbleState()
+{
+  int ticks = s_rumble_ticks.load(std::memory_order_acquire);
+  while (ticks > 0)
+  {
+    if (s_rumble_ticks.compare_exchange_weak(ticks, ticks - 1, std::memory_order_acq_rel))
+      return 1;
+  }
+  if (ticks == 0 && s_rumble_ticks.compare_exchange_strong(
+                        ticks, -1, std::memory_order_acq_rel))
+  {
+    return 0;
+  }
+  return -1;
+}
+}

+
+void Presenter::CaptureCurrentXFBForInterpolation()
+{
+  if (!m_xfb_entry || m_xfb_entry->texture->GetSamples() != 1)
+  {
+    ResetInterFrameHistory();
+    return;
+  }
+
+  const AbstractTexture* const source = m_xfb_entry->texture.get();
+  if (!m_previous_xfb_texture || m_previous_xfb_texture->GetWidth() != source->GetWidth() ||
+      m_previous_xfb_texture->GetHeight() != source->GetHeight() ||
+      m_previous_xfb_texture->GetFormat() != source->GetFormat() ||
+      m_previous_xfb_texture->GetLayers() != source->GetLayers() ||
+      m_previous_xfb_texture->GetSamples() != source->GetSamples())
+  {
+    m_previous_xfb_texture =
+        g_gfx->CreateTexture(source->GetConfig(), "Galaxy PC previous XFB");
+  }
+
+  if (!m_previous_xfb_texture)
+  {
+    ResetInterFrameHistory();
+    return;
+  }
+
+  m_previous_xfb_texture->CopyRectangleFromTexture(
+      source, source->GetRect(), 0, 0, m_previous_xfb_texture->GetRect(), 0, 0);
+  m_previous_xfb_texture->FinishedRendering();
+  m_previous_xfb_rect = m_xfb_rect;
+  m_previous_xfb_valid = true;
+}
+
+void Presenter::RecordOutputPresentation()
+{
+  const TimePoint now = Clock::now();
+  if (m_output_rate_window_start == TimePoint{})
+    m_output_rate_window_start = now;
+
+  ++m_output_presents_in_window;
+  const double elapsed =
+      std::chrono::duration<double>(now - m_output_rate_window_start).count();
+  if (elapsed >= 0.5)
+  {
+    m_output_presentation_rate =
+        static_cast<double>(m_output_presents_in_window) / elapsed;
+    m_output_presents_in_window = 0;
+    m_output_rate_window_start = now;
+  }
+}

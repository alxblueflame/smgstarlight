+bool Presenter::InitializeInterFramePipeline()
+{
+  m_inter_frame_pipeline.reset();
+  m_inter_frame_vertex_shader.reset();
+  m_inter_frame_pixel_shader.reset();
+
+  m_inter_frame_vertex_shader = g_gfx->CreateShaderFromSource(

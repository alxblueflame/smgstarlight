+void OnScreenUI::DrawAudioSettings()
+{
+  ImGui::TextUnformatted("Audio output");
+  ImGui::TextDisabled("Restart the game after changing the output mode.");
+  ImGui::Spacing();
+
+  static constexpr const char* audio_modes[] = {"Capture compatible (Cubeb)",
+                                                 "Low latency exclusive (WASAPI)"};
+  const std::string backend = Config::Get(Config::MAIN_AUDIO_BACKEND);
+  int audio_mode = backend == BACKEND_WASAPI ? 1 : 0;
+  ImGui::SetNextItemWidth(310.0f);
+  if (ImGui::Combo("Audio mode", &audio_mode, audio_modes, IM_ARRAYSIZE(audio_modes)))
+  {
+    Config::SetBaseOrCurrent(Config::MAIN_AUDIO_BACKEND,
+                             audio_mode == 0 ? std::string(BACKEND_CUBEB) :
+                                               std::string(BACKEND_WASAPI));
+  }
+  ImGui::TextWrapped("Capture compatible lets Xbox Game Bar and screen recorders include game "
+                     "audio. Exclusive mode can reduce latency, but capture software cannot hear it.");
+
+  ImGui::Spacing();
+  bool preserve_pitch = Config::Get(Config::MAIN_AUDIO_PRESERVE_PITCH);
+  if (ImGui::Checkbox("Preserve pitch when performance dips", &preserve_pitch))
+    Config::SetBaseOrCurrent(Config::MAIN_AUDIO_PRESERVE_PITCH, preserve_pitch);
+
+  int buffer_size = Config::Get(Config::MAIN_AUDIO_BUFFER_SIZE);
+  if (ImGui::SliderInt("Audio buffer (ms)", &buffer_size, 16, 160))
+    Config::SetBaseOrCurrent(Config::MAIN_AUDIO_BUFFER_SIZE, buffer_size);
+  ImGui::TextDisabled("Higher values prevent crackling when a scene hitches.");
+
+  bool fill_gaps = Config::Get(Config::MAIN_AUDIO_FILL_GAPS);
+  if (ImGui::Checkbox("Fill audio gaps", &fill_gaps))
+    Config::SetBaseOrCurrent(Config::MAIN_AUDIO_FILL_GAPS, fill_gaps);
+}
+
+void OnScreenUI::DrawSaveSettings()
+{
+  ImGui::TextUnformatted("Save data");
+  ImGui::TextDisabled("Backups are stored separately from the game's active Wii NAND data.");
+  ImGui::Spacing();
+
+  const u64 title_id = SConfig::GetInstance().GetTitleID();
+  if (ImGui::Button("Create backup", ImVec2(170.0f, 34.0f)))
+  {
+    const std::string save_path = Common::GetTitleDataPath(title_id) + "/";
+    const std::string backup_root = File::GetUserPath(D_BACKUP_IDX);
+    const std::string stamp = std::to_string(Common::Timer::NowMs());
+    const std::string destination = backup_root + "save-" + stamp + "/";
+    File::CreateFullPath(destination);
+    if (File::Copy(save_path, destination, true))
+      m_settings_status = "Save backed up to " + destination;
+    else
+      m_settings_status = "Backup failed. The game may not have created save data yet.";
+  }
+#ifdef _WIN32
+  ImGui::SameLine();
+  if (ImGui::Button("Open save folder", ImVec2(170.0f, 34.0f)))
+  {
+    std::string save_path = Common::GetTitleDataPath(title_id);
+    for (char& c : save_path)
+      if (c == '/')
+        c = '\\';
+    std::system(("explorer \"" + save_path + "\"").c_str());
+  }
+#endif
+
+  if (!m_settings_status.empty())
+  {
+    ImGui::Spacing();
+    ImGui::TextWrapped("%s", m_settings_status.c_str());
+  }
+}

+void OnScreenUI::DrawFrontendMenu()
+{
+  if (!m_show_frontend_menu || m_show_settings.load(std::memory_order_relaxed))
+    return;
+
+  const ImVec2 display = ImGui::GetIO().DisplaySize;
+  const bool a_pressed = (m_frontend_pressed & WiimoteEmu::Wiimote::BUTTON_A) != 0;
+  const bool b_pressed = (m_frontend_pressed & WiimoteEmu::Wiimote::BUTTON_B) != 0;
+  const bool up_pressed = (m_frontend_pressed & WiimoteEmu::Wiimote::PAD_UP) != 0;
+  const bool down_pressed = (m_frontend_pressed & WiimoteEmu::Wiimote::PAD_DOWN) != 0;
+  const float scale = std::clamp(display.y / 900.0f, 0.72f, 1.35f);
+  const float menu_width = 390.0f * scale;
+  const float right_margin = 66.0f * scale;
+  const float menu_x = display.x - menu_width - right_margin;
+  const float menu_y = m_frontend_confirm_exit ? 270.0f * scale : 250.0f * scale;
+  ImDrawList* const background = ImGui::GetBackgroundDrawList();
+
+  const auto draw_play_transition = [&] {
+    if (!m_frontend_play_transition)
+      return;
+    const int frame = m_frontend_transition_frames;
+    const float opacity = frame < 8 ? static_cast<float>(frame) / 8.0f :
+                                      1.0f - static_cast<float>(frame - 8) / 18.0f;
+    background->AddRectFilled(ImVec2(0, 0), display,
+                              IM_COL32(220, 242, 255,
+                                       static_cast<int>(255.0f * std::clamp(opacity, 0.0f, 1.0f))));
+  };
+
+  if (m_frontend_play_transition && m_frontend_transition_frames >= 8)
+  {
+    draw_play_transition();
+    return;
+  }
+
+  background->AddRectFilledMultiColor(
+      ImVec2(0, 0), display, IM_COL32(3, 7, 16, 178), IM_COL32(3, 8, 18, 238),
+      IM_COL32(3, 8, 18, 238), IM_COL32(3, 7, 16, 178));
+  background->AddRectFilledMultiColor(ImVec2(display.x * 0.48f, 0), display,
+                                      IM_COL32(3, 8, 18, 0), IM_COL32(2, 6, 14, 218),
+                                      IM_COL32(2, 6, 14, 218), IM_COL32(3, 8, 18, 0));
+
+  ImGui::SetNextWindowPos(ImVec2(0, 0));
+  ImGui::SetNextWindowSize(display);
+  ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(0, 0));
+  ImGui::PushStyleVar(ImGuiStyleVar_ItemSpacing, ImVec2(0, 12.0f * scale));
+  ImGui::PushStyleColor(ImGuiCol_WindowBg, ImVec4(0, 0, 0, 0));
+  ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0, 0, 0, 0));
+  ImGui::PushStyleColor(ImGuiCol_ButtonHovered, ImVec4(0, 0, 0, 0));
+  ImGui::PushStyleColor(ImGuiCol_ButtonActive, ImVec4(0, 0, 0, 0));
+  ImGui::Begin("GalaxyPCMainMenu", nullptr,
+               ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoMove |
+                   ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoBackground);
+
+  ImDrawList* const draw = ImGui::GetWindowDrawList();
+  draw->AddText(ImGui::GetFont(), 14.0f * scale,
+                ImVec2(display.x - right_margin - 128.0f * scale, 44.0f * scale),
+                IM_COL32(219, 231, 242, 235), "STARLIGHT  /  USA");
+  draw->AddText(ImGui::GetFont(), 13.0f * scale,
+                ImVec2(54.0f * scale, display.y - 48.0f * scale),
+                IM_COL32(191, 216, 233, 215), "SUPER MARIO GALAXY  /  RMGE01");
+
+  auto draw_item = [&](const char* id, const char* label, const char* detail, int index) {
+    const ImVec2 cursor = ImGui::GetCursorScreenPos();
+    const ImVec2 size(menu_width, 66.0f * scale);
+    ImGui::InvisibleButton(id, size);
+    if (ImGui::IsItemHovered())
+      m_frontend_selection = index;
+    const bool selected = m_frontend_selection == index;
+    if (selected)
+    {
+      draw->AddRectFilledMultiColor(cursor, ImVec2(cursor.x + size.x, cursor.y + size.y),
+                                    IM_COL32(104, 210, 255, 30), IM_COL32(225, 247, 255, 245),
+                                    IM_COL32(173, 219, 255, 235), IM_COL32(104, 210, 255, 30));
+      draw->AddRectFilled(ImVec2(cursor.x + size.x - 4.0f * scale, cursor.y),
+                          ImVec2(cursor.x + size.x, cursor.y + size.y),
+                          IM_COL32(224, 251, 255, 255));
+    }
+    const ImVec2 label_size =
+        ImGui::GetFont()->CalcTextSizeA(29.0f * scale, display.x, 0.0f, label);
+    draw->AddText(ImGui::GetFont(), 29.0f * scale,
+                  ImVec2(cursor.x + size.x - label_size.x - 30.0f * scale,
+                         cursor.y + 11.0f * scale),
+                  selected ? IM_COL32(8, 20, 38, 255) : IM_COL32(255, 255, 255, 245), label);
+    return m_frontend_accept_input && ImGui::IsItemClicked();
+  };
+
+  ImGui::SetCursorScreenPos(ImVec2(menu_x, menu_y));
+  bool activate = false;
+  if (m_frontend_confirm_exit)
+  {
+    draw->AddText(ImGui::GetFont(), 24.0f * scale, ImVec2(menu_x + 24.0f * scale,
+                                                         menu_y - 82.0f * scale),
+                  IM_COL32(255, 255, 255, 255), "EXIT THE GAME?");
+    draw->AddText(ImGui::GetFont(), 13.0f * scale, ImVec2(menu_x + 24.0f * scale,
+                                                         menu_y - 48.0f * scale),
+                  IM_COL32(187, 207, 224, 225), "Your save data is already safe.");
+    if (m_frontend_accept_input && (up_pressed || down_pressed))
+    {
+      m_frontend_selection = m_frontend_selection == 0 ? 1 : 0;
+      PlayFrontendFeedback(false);
+    }
+    ImGui::SetCursorScreenPos(ImVec2(menu_x, menu_y));
+    const bool exit_clicked = draw_item("##confirm_exit", "EXIT", "Close the game", 0);
+    ImGui::SetCursorScreenPos(ImVec2(menu_x, menu_y + 78.0f * scale));
+    const bool cancel_clicked = draw_item("##cancel_exit", "CANCEL", "Return to the menu", 1);
+    activate = m_frontend_accept_input && a_pressed;
+    if (exit_clicked || (activate && m_frontend_selection == 0))
+    {
+      PlayFrontendFeedback(true);
+      Core::QueueHostJob(&Core::Stop);
+    }
+    else if (cancel_clicked || b_pressed || (activate && m_frontend_selection == 1))
+    {
+      PlayFrontendFeedback(false);
+      m_frontend_confirm_exit = false;
+      m_frontend_selection = 2;
+      m_frontend_accept_input = false;
+    }
+  }
+  else
+  {
+    if (m_frontend_accept_input && up_pressed)
+    {
+      m_frontend_selection = (m_frontend_selection + 2) % 3;
+      PlayFrontendFeedback(false);
+    }
+    if (m_frontend_accept_input && down_pressed)
+    {
+      m_frontend_selection = (m_frontend_selection + 1) % 3;
+      PlayFrontendFeedback(false);
+    }
+
+    ImGui::SetCursorScreenPos(ImVec2(menu_x, menu_y));
+    const bool play_clicked = draw_item("##play", "PLAY", "Continue to the file select", 0);
+    ImGui::SetCursorScreenPos(ImVec2(menu_x, menu_y + 78.0f * scale));
+    const bool settings_clicked = draw_item("##settings", "SETTINGS", "Video, audio and controls", 1);
+    ImGui::SetCursorScreenPos(ImVec2(menu_x, menu_y + 156.0f * scale));
+    const bool exit_clicked = draw_item("##exit", "QUIT", "Return to the desktop", 2);
+    activate = m_frontend_accept_input && a_pressed;
+
+    if (play_clicked || (activate && m_frontend_selection == 0))
+    {
+      PlayFrontendFeedback(true);
+      m_frontend_play_transition = true;
+      m_frontend_transition_frames = 0;
+      m_frontend_accept_input = false;
+    }
+    else if (settings_clicked || (activate && m_frontend_selection == 1))
+    {
+      PlayFrontendFeedback(true);
+      m_show_frontend_menu = false;
+      m_show_settings = true;
+      m_settings_from_frontend = true;
+      m_settings_content_navigation = false;
+      m_settings_content_focus_pending = false;
+      m_frontend_accept_input = false;
+    }
+    else if (exit_clicked || (activate && m_frontend_selection == 2))
+    {
+      PlayFrontendFeedback(true);
+      m_frontend_confirm_exit = true;
+      m_frontend_selection = 1;
+      m_frontend_accept_input = false;
+    }
+  }
+
+  draw->AddText(ImGui::GetFont(), 13.0f * scale,
+                ImVec2(display.x - right_margin - 218.0f * scale,
+                       display.y - 48.0f * scale),
+                IM_COL32(207, 224, 237, 220), "D-PAD  NAVIGATE     A  SELECT");
+  draw_play_transition();
+  ImGui::End();
+  ImGui::PopStyleColor(4);
+  ImGui::PopStyleVar(2);
+}

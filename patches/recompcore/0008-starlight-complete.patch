+      "Galaxy PC inter-frame vertex shader");
+  m_inter_frame_pixel_shader = g_gfx->CreateShaderFromSource(
+      ShaderStage::Pixel, FramebufferShaderGen::GenerateInterFramePixelShader(), nullptr,
+      "Galaxy PC inter-frame pixel shader");
+  if (!m_inter_frame_vertex_shader || !m_inter_frame_pixel_shader)
+    return false;
+
+  AbstractPipelineConfig config = {};
+  config.vertex_shader = m_inter_frame_vertex_shader.get();
+  config.pixel_shader = m_inter_frame_pixel_shader.get();
+  config.rasterization_state =
+      RenderState::GetNoCullRasterizationState(PrimitiveType::Triangles);
+  config.depth_state = RenderState::GetNoDepthTestingDepthState();
+  config.blending_state = RenderState::GetNoBlendingBlendState();
+  config.framebuffer_state = RenderState::GetColorFramebufferState(m_backbuffer_format);
+  config.usage = AbstractPipelineUsage::Utility;
+  m_inter_frame_pipeline = g_gfx->CreatePipeline(config);
+  return static_cast<bool>(m_inter_frame_pipeline);
+}

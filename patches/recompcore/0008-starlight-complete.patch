+void PlayFrontendTone(float frequency, int milliseconds, float gain)
+{
+  SoundStream* const stream = Core::System::GetInstance().GetSoundStream();
+  if (!stream)
+    return;
+
+  constexpr int sample_rate = 8000;
+  constexpr float tau = 6.28318530718f;
+  const int frames = sample_rate * milliseconds / 1000;
+  std::vector<u8> samples(static_cast<std::size_t>(frames) * 2);
+  for (int i = 0; i < frames; ++i)
+  {
+    const float time = static_cast<float>(i) / sample_rate;
+    const float attack = std::min(1.0f, static_cast<float>(i) / (sample_rate * 0.004f));
+    const float release = 1.0f - static_cast<float>(i) / frames;
+    const float wave = std::sin(tau * frequency * time) +
+                       0.22f * std::sin(tau * frequency * 2.0f * time);
+    const s16 sample = static_cast<s16>(wave * attack * release * release * gain * 32767.0f);
+    samples[static_cast<std::size_t>(i) * 2] = static_cast<u8>(sample);
+    samples[static_cast<std::size_t>(i) * 2 + 1] = static_cast<u8>(sample >> 8);
+  }
+  stream->GetMixer()->PushSkylanderPortalSamples(samples.data(), frames);
+}
+
+void PlayFrontendFeedback(bool confirm)
+{
+  PlayFrontendTone(confirm ? 880.0f : 620.0f, confirm ? 85 : 45, confirm ? 0.14f : 0.09f);
+  FrontendInput::RequestRumble(confirm ? 16 : 5);
+}

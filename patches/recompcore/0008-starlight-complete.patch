+void OnScreenUI::UpdateFrontendMenu()
+{
+  const u16 buttons = FrontendInput::GetButtons();
+  m_frontend_pressed = buttons & static_cast<u16>(~m_frontend_buttons);
+  m_frontend_buttons = buttons;
+
+  const bool a_down = (buttons & WiimoteEmu::Wiimote::BUTTON_A) != 0;
+  const bool b_down = (buttons & WiimoteEmu::Wiimote::BUTTON_B) != 0;
+  const bool up_down = (buttons & WiimoteEmu::Wiimote::PAD_UP) != 0;
+  const bool down_down = (buttons & WiimoteEmu::Wiimote::PAD_DOWN) != 0;
+  const bool left_down = (buttons & WiimoteEmu::Wiimote::PAD_LEFT) != 0;
+  const bool right_down = (buttons & WiimoteEmu::Wiimote::PAD_RIGHT) != 0;
+  const bool a_pressed = (m_frontend_pressed & WiimoteEmu::Wiimote::BUTTON_A) != 0;
+  const bool b_pressed = (m_frontend_pressed & WiimoteEmu::Wiimote::BUTTON_B) != 0;
+  const bool up_pressed = (m_frontend_pressed & WiimoteEmu::Wiimote::PAD_UP) != 0;
+  const bool down_pressed = (m_frontend_pressed & WiimoteEmu::Wiimote::PAD_DOWN) != 0;
+  const bool right_pressed = (m_frontend_pressed & WiimoteEmu::Wiimote::PAD_RIGHT) != 0;
+
+  if (!Config::Get(Config::MAIN_STATICRECOMP_CUSTOM_FRONTEND))
+  {
+    if (FrontendInput::IsFileSelectCaptured())
+      FrontendInput::ReleaseFileSelect();
+    m_frontend_finished = true;
+    m_show_frontend_menu = false;
+  }
+
+  if (m_frontend_play_transition)
+  {
+    ++m_frontend_transition_frames;
+    if (m_frontend_transition_frames == 8)
+      FrontendInput::ReleaseFileSelect();
+    if (m_frontend_transition_frames >= 26)
+    {
+      m_frontend_play_transition = false;
+      m_frontend_finished = true;
+      m_show_frontend_menu = false;
+    }
+    return;
+  }
+
+  if (!m_frontend_finished && !FrontendInput::IsFileSelectCaptured())
+  {
+    const u16 title_buttons = WiimoteEmu::Wiimote::BUTTON_A | WiimoteEmu::Wiimote::BUTTON_B;
+    if (!m_frontend_title_confirmed && (buttons & title_buttons) == title_buttons)
+    {
+      m_frontend_title_confirmed = true;
+      FrontendInput::ConfirmTitle();
+      m_frontend_transition_frames = 0;
+    }
+    if (m_frontend_title_confirmed && ++m_frontend_transition_frames >= 180)
+      FrontendInput::CaptureFileSelect();
+  }
+
+  if (m_frontend_finished && !m_settings_from_frontend)
+  {
+    m_show_frontend_menu = false;
+    m_frontend_confirm_exit = false;
+    return;
+  }
+
+  if (!m_frontend_finished && FrontendInput::IsFileSelectReady() &&
+      !m_show_frontend_menu && !m_show_settings)
+  {
+    m_show_frontend_menu = true;
+    m_frontend_selection = 0;
+    m_frontend_confirm_exit = false;
+    m_frontend_accept_input = false;
+  }
+
+  if (!a_down && !b_down)
+    m_frontend_accept_input = true;
+
+  if (m_settings_from_frontend && m_frontend_accept_input && b_pressed)
+  {
+    PlayFrontendFeedback(false);
+    if (m_settings_content_navigation)
+    {
+      m_settings_content_navigation = false;
+    }
+    else
+    {
+      m_show_settings = false;
+      m_settings_from_frontend = false;
+      m_show_frontend_menu = true;
+    }
+    m_frontend_accept_input = false;
+  }
+
+  if (m_settings_from_frontend && m_frontend_accept_input &&
+      !m_settings_content_navigation && !b_pressed)
+  {
+    if (up_pressed)
+    {
+      m_settings_category = (m_settings_category + 6) % 7;
+      PlayFrontendFeedback(false);
+    }
+    else if (down_pressed)
+    {
+      m_settings_category = (m_settings_category + 1) % 7;
+      PlayFrontendFeedback(false);
+    }
+    else if (a_pressed || right_pressed)
+    {
+      m_settings_content_navigation = true;
+      m_settings_content_focus_pending = true;
+      PlayFrontendFeedback(true);
+      m_frontend_accept_input = false;
+    }
+  }
+
+  const bool settings_nav = m_show_settings.load(std::memory_order_relaxed) &&
+                            m_settings_content_navigation && m_frontend_accept_input && !b_pressed;
+  ImGuiIO& io = ImGui::GetIO();
+  io.AddKeyEvent(ImGuiKey_GamepadFaceDown, settings_nav && a_down);
+  io.AddKeyEvent(ImGuiKey_GamepadDpadUp, settings_nav && up_down);
+  io.AddKeyEvent(ImGuiKey_GamepadDpadDown, settings_nav && down_down);
+  io.AddKeyEvent(ImGuiKey_GamepadDpadLeft, settings_nav && left_down);
+  io.AddKeyEvent(ImGuiKey_GamepadDpadRight, settings_nav && right_down);
+
+  if (settings_nav &&
+      (m_frontend_pressed & (WiimoteEmu::Wiimote::PAD_UP | WiimoteEmu::Wiimote::PAD_DOWN |
+                             WiimoteEmu::Wiimote::PAD_LEFT | WiimoteEmu::Wiimote::PAD_RIGHT)))
+  {
+    PlayFrontendFeedback(false);
+  }
+  if (settings_nav &&
+      (m_frontend_pressed & WiimoteEmu::Wiimote::BUTTON_A) != 0)
+  {
+    PlayFrontendFeedback(true);
+  }
+}

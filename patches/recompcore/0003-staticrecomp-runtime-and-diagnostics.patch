+u64 s_burst_trace_limit = 0;
+u64 s_burst_trace_hash = FNV_OFFSET_BASIS;
+u32 s_burst_trace_context = 0;
+u64 s_burst_trace_dispatch = 0;
+u32 s_burst_trace_last_context = 0;
+u32 s_burst_trace_dispatch_entry = 0;

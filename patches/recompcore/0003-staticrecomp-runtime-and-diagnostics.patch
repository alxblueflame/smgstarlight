+void SetBurstTraceContext(u32 context, u64 dispatch)
+{
+  s_burst_trace_context = context;
+  s_burst_trace_dispatch = dispatch;
+}
+
+void SetBurstTraceDispatchEntry(u32 entry)
+{
+  s_burst_trace_dispatch_entry = entry;
+}
+
+BurstTraceSummary GetBurstTraceSummary()
+{
+  return {static_cast<u64>(s_burst_trace_prefixes.size()), s_burst_trace_limit,
+          s_burst_trace_prefixes.empty() ? FNV_OFFSET_BASIS : s_burst_trace_prefixes.back(),
+          s_burst_trace_last_context, s_burst_trace_last_dispatch_entry,
+          s_burst_trace_last_dispatch, s_burst_trace_last_ticks, s_burst_trace_last_data};
+}
+
+bool SaveBurstTrace(const std::string& path)
+{
+  std::ofstream file(path, std::ios::binary | std::ios::trunc);
+  if (!file)
+    return false;
+
+  file.write("MGFIFOH6", 8);
+  const u64 count = static_cast<u64>(s_burst_trace_prefixes.size());
+  file.write(reinterpret_cast<const char*>(&count), sizeof(count));
+  file.write(reinterpret_cast<const char*>(s_burst_trace_prefixes.data()),
+             static_cast<std::streamsize>(s_burst_trace_prefixes.size() * sizeof(u64)));
+  file.write(reinterpret_cast<const char*>(s_burst_trace_chunks.data()),
+             static_cast<std::streamsize>(s_burst_trace_chunks.size() * sizeof(u64)));
+  file.write(reinterpret_cast<const char*>(s_burst_trace_contexts.data()),
+             static_cast<std::streamsize>(s_burst_trace_contexts.size() * sizeof(u32)));
+  file.write(reinterpret_cast<const char*>(s_burst_trace_dispatch_entries.data()),
+             static_cast<std::streamsize>(s_burst_trace_dispatch_entries.size() * sizeof(u32)));
+  file.write(reinterpret_cast<const char*>(s_burst_trace_dispatches.data()),
+             static_cast<std::streamsize>(s_burst_trace_dispatches.size() * sizeof(u64)));
+  file.write(reinterpret_cast<const char*>(s_burst_trace_ticks.data()),
+             static_cast<std::streamsize>(s_burst_trace_ticks.size() * sizeof(u64)));
+  file.write(reinterpret_cast<const char*>(s_burst_trace_data.data()),
+             static_cast<std::streamsize>(s_burst_trace_data.size()));
+  file.write(reinterpret_cast<const char*>(&s_burst_trace_last_context),
+             sizeof(s_burst_trace_last_context));
+  file.write(reinterpret_cast<const char*>(&s_burst_trace_last_dispatch_entry),
+             sizeof(s_burst_trace_last_dispatch_entry));
+  file.write(reinterpret_cast<const char*>(&s_burst_trace_last_dispatch),
+             sizeof(s_burst_trace_last_dispatch));
+  file.write(reinterpret_cast<const char*>(&s_burst_trace_last_ticks),
+             sizeof(s_burst_trace_last_ticks));
+  file.write(reinterpret_cast<const char*>(s_burst_trace_last_data.data()),
+             static_cast<std::streamsize>(s_burst_trace_last_data.size()));
+  return file.good();
+}
 }  // namespace GPFifo

+void TraceBurst(const u8* data, u64 ticks)
+{
+  if (s_burst_trace_limit == 0 || s_burst_trace_prefixes.size() >= s_burst_trace_limit)
+    return;
+
+  u64 chunk_hash = FNV_OFFSET_BASIS;
+  for (size_t i = 0; i < GATHER_PIPE_SIZE; ++i)
+  {
+    s_burst_trace_hash ^= data[i];
+    s_burst_trace_hash *= FNV_PRIME;
+    chunk_hash ^= data[i];
+    chunk_hash *= FNV_PRIME;
+  }
+  std::copy_n(data, GATHER_PIPE_SIZE, s_burst_trace_last_data.begin());
+  s_burst_trace_last_context = s_burst_trace_context;
+  s_burst_trace_last_dispatch_entry = s_burst_trace_dispatch_entry;
+  s_burst_trace_last_dispatch = s_burst_trace_dispatch;
+  s_burst_trace_last_ticks = ticks;
+  s_burst_trace_prefixes.push_back(s_burst_trace_hash);
+  s_burst_trace_chunks.push_back(chunk_hash);
+  s_burst_trace_contexts.push_back(s_burst_trace_context);
+  s_burst_trace_dispatch_entries.push_back(s_burst_trace_dispatch_entry);
+  s_burst_trace_dispatches.push_back(s_burst_trace_dispatch);
+  s_burst_trace_ticks.push_back(ticks);
+  s_burst_trace_data.insert(s_burst_trace_data.end(), data, data + GATHER_PIPE_SIZE);
+}
+}  // namespace
+

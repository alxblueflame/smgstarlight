+void OnScreenUI::DrawSettingsPanel()
+{
+  if (!m_show_settings.load(std::memory_order_relaxed))
+    return;
+
+  ImGui::SetNextWindowPos(ImVec2(24.0f * m_backbuffer_scale, 24.0f * m_backbuffer_scale),
+                          ImGuiCond_FirstUseEver);
+  ImGui::SetNextWindowBgAlpha(0.94f);
+  bool open = true;
+  if (ImGui::Begin("Settings  (F2 to close)", &open, ImGuiWindowFlags_AlwaysAutoResize))
+  {
+    // Internal resolution: Dolphin applies GFX_EFB_SCALE changes live.
+    static const char* const resolutions[] = {"Auto (window size)", "1x (640x528)",
+                                              "2x (1280x1056)",     "3x (1920x1584)",
+                                              "4x (2560x2112)",     "5x (3200x2640)",
+                                              "6x (3840x3168)"};
+    int scale = Config::Get(Config::GFX_EFB_SCALE);
+    if (scale < 0 || scale > 6)
+      scale = 0;
+    if (ImGui::Combo("Internal resolution", &scale, resolutions, IM_ARRAYSIZE(resolutions)))
+      Config::SetBaseOrCurrent(Config::GFX_EFB_SCALE, scale);
+
+    float speed = Config::Get(Config::MAIN_EMULATION_SPEED);
+    bool unlimited = speed <= 0.0f;
+    if (ImGui::Checkbox("Unlimited speed", &unlimited))
+      Config::SetBaseOrCurrent(Config::MAIN_EMULATION_SPEED, unlimited ? 0.0f : 1.0f);
+    if (!unlimited)
+    {
+      if (ImGui::SliderFloat("Speed limit", &speed, 0.25f, 2.0f, "%.2fx"))
+        Config::SetBaseOrCurrent(Config::MAIN_EMULATION_SPEED, speed);
+    }
+
+    bool vsync = Config::Get(Config::GFX_VSYNC);
+    if (ImGui::Checkbox("VSync", &vsync))
+      Config::SetBaseOrCurrent(Config::GFX_VSYNC, vsync);
+
+    bool show_fps = Config::Get(Config::GFX_SHOW_FPS);
+    if (ImGui::Checkbox("FPS / speed overlay", &show_fps))
+    {
+      Config::SetBaseOrCurrent(Config::GFX_SHOW_FPS, show_fps);
+      Config::SetBaseOrCurrent(Config::GFX_SHOW_SPEED, show_fps);
+    }
+
+    bool hires = Config::Get(Config::GFX_HIRES_TEXTURES);
+    if (ImGui::Checkbox("Custom HD textures", &hires))
+      Config::SetBaseOrCurrent(Config::GFX_HIRES_TEXTURES, hires);
+
+    ImGui::Separator();
+    const u64 title_id = SConfig::GetInstance().GetTitleID();
+    if (ImGui::Button("Back up save now"))
+    {
+      const std::string save_path = Common::GetTitleDataPath(title_id) + "/";
+      const std::string backup_root = File::GetUserPath(D_BACKUP_IDX);
+      const std::string stamp = std::to_string(Common::Timer::NowMs());
+      const std::string destination = backup_root + "save-" + stamp + "/";
+      File::CreateFullPath(destination);
+      if (File::Copy(save_path, destination, true))
+        m_settings_status = "Save backed up to " + destination;
+      else
+        m_settings_status = "Backup failed (no save data yet?)";
+    }
+#ifdef _WIN32
+    ImGui::SameLine();
+    if (ImGui::Button("Open save folder"))
+    {
+      const std::string save_path = Common::GetTitleDataPath(title_id);
+      std::string command = "explorer \"" + save_path + "\"";
+      for (char& c : command)
+        if (c == '/')
+          c = '\\';
+      std::system(command.c_str());
+    }
+#endif
+    if (!m_settings_status.empty())
+      ImGui::TextWrapped("%s", m_settings_status.c_str());
+    ImGui::TextDisabled("The game keeps running behind this panel.");
+  }
+  ImGui::End();
+  if (!open)
+    m_show_settings = false;
+}

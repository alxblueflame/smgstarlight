+  s_burst_trace_chunks.clear();
+  s_burst_trace_contexts.clear();
+  s_burst_trace_dispatch_entries.clear();
+  s_burst_trace_dispatches.clear();
+  s_burst_trace_ticks.clear();
+  s_burst_trace_data.clear();
+  if (burst_limit != 0)
+  {
+    s_burst_trace_prefixes.reserve(static_cast<size_t>(burst_limit));
+    s_burst_trace_chunks.reserve(static_cast<size_t>(burst_limit));
+    s_burst_trace_contexts.reserve(static_cast<size_t>(burst_limit));
+    s_burst_trace_dispatch_entries.reserve(static_cast<size_t>(burst_limit));
+    s_burst_trace_dispatches.reserve(static_cast<size_t>(burst_limit));
+    s_burst_trace_ticks.reserve(static_cast<size_t>(burst_limit));
+    s_burst_trace_data.reserve(static_cast<size_t>(burst_limit) * GATHER_PIPE_SIZE);
+  }
+}
+
+bool BurstTraceEnabled()
+{
+  return s_burst_trace_limit != 0;
+}

index 531c6d1..ccbca5a 100644
--- a/GXRuntime/include/core/cpu.h
+++ b/GXRuntime/include/core/cpu.h
@@ -6,10 +6,13 @@
 // more msvc shit fuck msvc
 #if defined(_MSC_VER)
 #define GXRUNTIME_ALWAYS_INLINE __forceinline
+#define GXRUNTIME_RESTRICT __restrict
 #elif defined(__GNUC__) || defined(__clang__)
 #define GXRUNTIME_ALWAYS_INLINE inline __attribute__((always_inline))

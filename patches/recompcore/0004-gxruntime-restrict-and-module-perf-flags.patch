 // Minimal CPU support ABI for generated code and CPU tests.
diff --git a/module-template/CMakeLists.txt b/module-template/CMakeLists.txt
index a49e3cc..68f085d 100644
--- a/module-template/CMakeLists.txt
+++ b/module-template/CMakeLists.txt
@@ -84,5 +84,9 @@ elseif(CMAKE_C_COMPILER_ID STREQUAL "GNU")
   target_compile_options(${MODULE_NAME} PRIVATE -O2 -fvisibility=hidden
                          -ffp-contract=off -fno-fast-math)
 elseif(MSVC)
-  target_compile_options(${MODULE_NAME} PRIVATE /fp:strict)
+  # /fp:precise keeps per-operation IEEE semantics without contraction (the
+  # VS2022 default is fp:contract off) — the generated code encodes Gekko
+  # rounding explicitly, so fp:strict's exception/denormal bookkeeping only
+  # costs time. /GS- drops stack cookies in the leaf-heavy generated chunks.
+  target_compile_options(${MODULE_NAME} PRIVATE /fp:precise /GS- /Ob3 /Gw)
 endif()

diff --git a/GXRuntime/src/core/cpu.c b/GXRuntime/src/core/cpu.c
--- a/GXRuntime/src/core/cpu.c
+++ b/GXRuntime/src/core/cpu.c
@@ -180,6 +180,94 @@ u32 ppc_mftb(CPUState* cpu, u16 tbr, u32 cia) {
     ppc_program_exception(cpu, PPC_PROGRAM_ILLEGAL, cia);
     return 0;
 }
+
+static u32 ppc_spr_field(u16 spr) {
+    return ((u32)(spr & 0x1Fu) << 16) | ((u32)(spr & 0x3E0u) << 6);
+}
+
+u32 ppc_mfspr(CPUState* cpu, u16 spr, u32 cia) {
+    switch (spr) {
+    case 1: return cpu->xer;
+    case 8: return cpu->lr;
+    case 9: return cpu->ctr;
+    case 18: return cpu->dsisr;
+    case 19: return cpu->dar;
+    case 26: return cpu->srr0;
+    case 27: return cpu->srr1;
+    case 282: return cpu->ear;
+    case 912:
+    case 913:
+    case 914:
+    case 915:
+    case 916:
+    case 917:
+    case 918:
+    case 919:
+        return cpu->gqr[spr - 912];
+    case 920:
+        return cpu->hid2;
+    default:
+        break;
+    }
+
+    if (!cpu->instruction_fallback) {
+        ppc_program_exception(cpu, PPC_PROGRAM_ILLEGAL, cia);
+        return 0;
+    }
+
+    u32 saved_r0 = cpu->gpr[0];
+    u32 raw = (31u << 26) | ppc_spr_field(spr) | (339u << 1);
+    ppc_fallback_instruction(cpu, raw, cia);
+    u32 value = cpu->gpr[0];
+    cpu->gpr[0] = saved_r0;
+    return value;
+}
+
+void ppc_mtspr(CPUState* cpu, u16 spr, u32 value, u32 cia) {
+    switch (spr) {
+    case 1: cpu->xer = value; return;
+    case 8: cpu->lr = value; return;
+    case 9: cpu->ctr = value; return;
+    case 18: cpu->dsisr = value; return;
+    case 19: cpu->dar = value; return;
+    case 26: cpu->srr0 = value; return;
+    case 27: cpu->srr1 = value; return;
+    case 282: cpu->ear = value; return;
+    case 284:
+        cpu->timebase = (cpu->timebase & 0xFFFFFFFF00000000ull) | value;
+        return;
+    case 285:
+        cpu->timebase = ((u64)value << 32) | (cpu->timebase & 0xFFFFFFFFull);
+        return;
+    case 912:
+    case 913:
+    case 914:
+    case 915:
+    case 916:
+    case 917:
+    case 918:
+    case 919:
+        cpu->gqr[spr - 912] = value;
+        return;
+    case 920:
+        cpu->hid2 = value;
+        return;
+    default:
+        break;
+    }
+
+    if (!cpu->instruction_fallback) {
+        ppc_program_exception(cpu, PPC_PROGRAM_ILLEGAL, cia);
+        return;
+    }
+
+    u32 saved_r0 = cpu->gpr[0];
+    u32 raw = (31u << 26) | ppc_spr_field(spr) | (467u << 1);
+    cpu->gpr[0] = value;
+    ppc_fallback_instruction(cpu, raw, cia);
+    cpu->gpr[0] = saved_r0;
+}
+
 static s32 gqr_scale(u32 value) {
     return sign_extend(value & 0x3Fu, 6);
 }
